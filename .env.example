# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.

# Shared password for the team. Leave empty locally to skip the login.
APP_PASSWORD=

# Model. Claude by default. Set AI_PROVIDER=gemini to run Soukita's Gemini setup instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Added automatically by Vercel when you connect a Neon database (Storage tab). Not needed locally.
# Photos are stored in the database: no separate photo storage to set up.
# DATABASE_URL=
